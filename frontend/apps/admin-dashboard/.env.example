# REST API base used by @smartad/api-client
VITE_API_BASE_URL=http://localhost:8080/api

# Raw STOMP-over-WebSocket endpoint used by @smartad/websocket
VITE_WS_URL=ws://localhost:8080/ws

# Dev origin of the TV display app (apps/tv-display), used for the
# "Open TV Display" link on the session detail page.
VITE_TV_DISPLAY_URL=http://localhost:5173

# Dev origin of the mobile-web app (apps/mobile-web), used on the Config page.
VITE_MOBILE_WEB_URL=http://localhost:5174
