# ===================================================================
# Local (non-Docker) backend run config — mirrors application.yml's
# defaults. Copy to backend/.env and adjust if your local MySQL/Redis/
# MinIO aren't on these defaults. Used by:
#   - `mvn spring-boot:run` (if you export these, e.g. via `set -a; source .env`)
#   - VS Code's "Backend: Launch (Java, local mvn/JDK)" launch config (envFile)
# Root .env / docker-compose.yml is a SEPARATE file — it has no effect on
# this local-run path. See docs/ENVIRONMENT.md for the full picture.
# ===================================================================

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartad?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=ads

JWT_SECRET=this-is-a-local-development-only-jwt-secret-change-me
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
APP_FRONTEND_MOBILE_URL=http://localhost:5174
