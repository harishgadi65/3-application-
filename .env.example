# ===================================================================
# Smart Interactive Advertising & Gaming Platform - Environment Config
# Copy this file to .env and adjust values as needed.
# ===================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smartad
MYSQL_USER=smartad
MYSQL_PASSWORD=smartadpass
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ads
# Used by the backend AWS S3 SDK client (points at MinIO for this demo)
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# ---- JWT ----
JWT_SECRET=change-this-super-secret-key-for-jwt-signing-min-256-bits-long
JWT_EXPIRATION_MS=86400000

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Comma-separated origins allowed to call the API / connect the WebSocket
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Base URL encoded into session-join QR codes (should be the mobile-web app's origin)
APP_FRONTEND_MOBILE_URL=http://localhost:5174
# Shared password required to register a physical TV/browser with a display code
TV_SETUP_PASSWORD=smartadtv123

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
